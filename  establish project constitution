[32m+[m[32m## III. Modular Monolith First[m
[32m+[m
[32m+[m[32mBackend başlangıçta modüler monolit olacaktır.[m
[32m+[m
[32m+[m[32mAna iş alanları açık modül sınırlarıyla ayrılmalıdır.[m
[32m+[m
[32m+[m[32mBaşlangıçta öngörülen modüller:[m
[32m+[m
[32m+[m[32m* Identity[m
[32m+[m[32m* Users[m
[32m+[m[32m* Animals[m
[32m+[m[32m* Posts[m
[32m+[m[32m* Interactions[m
[32m+[m[32m* Feed[m
[32m+[m[32m* Moderation[m
[32m+[m[32m* Weekly Highlights[m
[32m+[m
[32m+[m[32mModüller başka modüllerin iç implementasyon ayrıntılarına gereksiz şekilde bağımlı olmamalıdır.[m
[32m+[m
[32m+[m[32mMikroservis, message broker veya dağıtık sistem altyapısı gerçek ihtiyaç oluşmadan eklenmemelidir.[m
[32m+[m
[32m+[m[32m## IV. Clear Domain Ownership[m
[32m+[m
[32m+[m[32mHer iş kuralının açık bir sahibi olmalıdır.[m
[32m+[m
[32m+[m[32mÖzellikle:[m
[32m+[m
[32m+[m[32m* User ve Animal farklı domain kavramlarıdır.[m
[32m+[m[32m* Animal ile Street Encounter aynı kavram değildir.[m
[32m+[m[32m* Post içerik yaşam döngüsünden sorumludur.[m
[32m+[m[32m* Interaction sosyal etkileşimlerden sorumludur.[m
[32m+[m[32m* Feed gönderilerin sahibi değildir; onları seçer ve sunar.[m
[32m+[m
[32m+[m[32mAynı iş kuralı birden fazla modülde tekrar edilmemelidir.[m
[32m+[m
[32m+[m[32m## V. Android Architecture Boundaries[m
[32m+[m
[32m+[m[32mAndroid uygulaması feature tabanlı geliştirilecektir.[m
[32m+[m
[32m+[m[32mUI:[m
[32m+[m
[32m+[m[32m* Doğrudan HTTP isteği yapmamalıdır.[m
[32m+[m[32m* Doğrudan ana veri kaynağına erişmemelidir.[m
[32m+[m[32m* İş kurallarını Composable içerisine gömmemelidir.[m
[32m+[m
[32m+[m[32mTemel veri akışı tek yönlü olmalıdır:[m
[32m+[m
[32m+[m[32mUI Event[m
[32m+[m[32m→ ViewModel[m
[32m+[m[32m→ Application / Repository[m
[32m+[m[32m→ Data Source[m
[32m+[m
[32m+[m[32mState[m
[32m+[m[32m→ ViewModel[m
[32m+[m[32m→ UI[m
[32m+[m
[32m+[m[32mUI state açık ve test edilebilir olmalıdır.[m
[32m+[m
[32m+[m[32m## VI. API Is a Contract[m
[32m+[m
[32m+[m[32mAndroid ile backend arasındaki API geçici bir implementation detayı değildir.[m
[32m+[m
[32m+[m[32mAPI sözleşmeleri:[m
[32m+[m
[32m+[m[32m* Açık[m
[32m+[m[32m* Tutarlı[m
[32m+[m[32m* Geriye uyumluluğu gözeten[m
[32m+[m[32m* Hata davranışları tanımlı[m
[32m+[m
[32m+[m[32molmalıdır.[m
[32m+[m
[32m+[m[32mMobil uygulamanın eski sürümlerini gereksiz yere bozacak contract değişikliklerinden kaçınılmalıdır.[m
[32m+[m
[32m+[m[32mKırıcı değişiklikler açıkça gerekçelendirilmelidir.[m
[32m+[m
[32m+[m[32m## VII. Database Changes Must Be Controlled[m
[32m+[m
[32m+[m[32mVeritabanı şeması kontrollü migration'larla değiştirilmelidir.[m
[32m+[m
[32m+[m[32mMigration'lar:[m
[32m+[m
[32m+[m[32m* Mevcut veriyi gereksiz yere kaybetmemeli[m
[32m+[m[32m* Geriye uyumluluğu dikkate almalı[m
[32m+[m[32m* Production verisi varmış gibi değerlendirilmelidir[m
[32m+[m
[32m+[m[32mŞema değişiklikleri yalnızca geliştirme kolaylığı için rastgele yapılmamalıdır.[m
[32m+[m
[32m+[m[32m## VIII. Security Is Server-Enforced[m
[32m+[m
[32m+[m[32mMobil istemci güvenilir bir sistem sınırı değildir.[m
[32m+[m
[32m+[m[32mKimlik doğrulama, yetkilendirme ve kritik iş kuralları backend tarafından doğrulanmalıdır.[m
[32m+[m
[32m+[m[32mAndroid uygulamasında bir butonun gizlenmesi güvenlik önlemi sayılmaz.[m
[32m+[m
[32m+[m[32mBir kullanıcı yalnızca yetkisi bulunan kaynaklar üzerinde işlem yapabilmelidir.[m
[32m+[m
[32m+[m[32m## IX. User and Animal Safety[m
[32m+[m
[32m+[m[32mHayvan Çıkabilir kullanıcı tarafından oluşturulan içerik barındıran bir platformdur.[m
[32m+[m
[32m+[m[32mBu nedenle güvenlik ve moderasyon sonradan düşünülen yardımcı özellikler değildir.[m
[32m+[m
[32m+[m[32mÜrün geliştirilirken:[m
[32m+[m
[32m+[m[32m* Kullanıcı güvenliği[m
[32m+[m[32m* Hayvan güvenliği[m
[32m+[m[32m* Konum mahremiyeti[m
[32m+[m[32m* İçerik raporlama[m
[32m+[m[32m* Kullanıcı engelleme[m
[32m+[m[32m* Yetkisiz hayvan sahipliği iddiaları[m
[32m+[m
[32m+[m[32mgibi riskler dikkate alınmalıdır.[m
[32m+[m
[32m+[m[32mKesin konum gibi hassas bilgiler varsayılan olarak herkese açık tasarlanmamalıdır.[m
[32m+[m
[32m+[m[32m## X. Tests Follow Risk[m
[32m+[m
[32m+[m[32mHer dosya veya sınıf için anlamsız test yazılması zorunlu değildir.[m
[32m+[m
[32m+[m[32mAncak aşağıdaki alanlar test edilmelidir:[m
[32m+[m
[32m+[m[32m* Kritik domain kuralları[m
[32m+[m[32m* Yetkilendirme[m
[32m+[m[32m* Veri bütünlüğü[m
[32m+[m[32m* API contract davranışları[m
[32m+[m[32m* Önemli kullanıcı akışları[m
[32m+[m[32m* Hata ve edge-case davranışları[m
[32m+[m
[32m+[m[32mTest stratejisi feature planının parçası olmalıdır.[m
[32m+[m
[32m+[m[32m## XI. No Premature Complexity[m
[32m+[m
[32m+[m[32mAşağıdaki teknolojiler gerçek ihtiyaç oluşmadan eklenmemelidir:[m
[32m+[m
[32m+[m[32m* Mikroservis[m
[32m+[m[32m* Kubernetes[m
[32m+[m[32m* Kafka[m
[32m+[m[32m* RabbitMQ[m
[32m+[m[32m* Event Sourcing[m
[32m+[m[32m* Elasticsearch[m
[32m+[m[32m* Redis[m
[32m+[m[32m* Server-driven UI[m
[32m+[m[32m* Ayrı read/write veritabanları[m
[32m+[m
[32m+[m[32mYeni altyapı eklemeden önce mevcut yapının neden yetersiz olduğu açıklanmalıdır.[m
[32m+[m
[32m+[m[32m## XII. Extensibility Without Speculation[m
[32m+[m
[32m+[m[32mSistem yeni özellikler eklenebilecek şekilde tasarlanmalıdır.[m
[32m+[m
[32m+[m[32mAncak gelecekte belki gerekli olur düşüncesiyle:[m
[32m+[m
[32m+[m[32m* Gereksiz interface[m
[32m+[m[32m* Gereksiz generic abstraction[m
[32m+[m[32m* Gereksiz base class[m
[32m+[m[32m* Gereksiz repository[m
[32m+[m[32m* Gereksiz servis katmanı[m
[32m+[m
[32m+[m[32moluşturulmamalıdır.[m
[32m+[m
[32m+[m[32mGenişletilebilirlik, doğru sorumluluk sınırlarından gelmelidir; aşırı soyutlamadan değil.[m
[32m+[m
[32m+[m[32m## XIII. Documentation Has Ownership[m
[32m+[m
[32m+[m[32mBelgelerin görevleri karıştırılmamalıdır.[m
[32m+[m
[32m+[m[32m### `docs/product`[m
[32m+[m
[32m+[m[32mÜrün kararlarının kaynağıdır.[m
[32m+[m
[32m+[m[32m### `docs/architecture`[m
[32m+[m
[32m+[m[32mSistem genelindeki mimari kararların kaynağıdır.[m
[32m+[m
[32m+[m[32m### `docs/ux`[m
[32m+[m
[32m+[m[32mGenel kullanıcı deneyimi ve navigation kararlarının kaynağıdır.[m
[32m+[m
[32m+[m[32m### `specs/<feature>`[m
[32m+[m
[32m+[m[32mTek bir özelliğin gereksinim, plan, veri modeli, contract ve görevlerinin kaynağıdır.[m
[32m+[m
[32m+[m[32mBir feature'a özel detay global dokümanlara gereksiz yere taşınmamalıdır.[m
[32m+[m
[32m+[m[32m## XIV. Human Review Gates[m
[32m+[m
[32m+[m[32mKod ajanı kritik aşamalarda otomatik olarak sonraki aşamaya geçmemelidir.[m
[32m+[m
[32m+[m[32mHer feature için dört temel kontrol noktası vardır:[m
[32m+[m
[32m+[m[32m### Gate 1 — Specification[m
[32m+[m
[32m+[m[32mNe yaptığımız doğru mu?[m
[32m+[m
[32m+[m[32m### Gate 2 — Technical Plan[m
[32m+[m
[32m+[m[32mNasıl yapacağımız doğru mu?[m
[32m+[m
[32m+[m[32m### Gate 3 — Tasks[m
[32m+[m
[32m+[m[32mİş sırası ve kapsam doğru mu?[m
[32m+[m
[32m+[m[32m### Gate 4 — Implementation[m
[32m+[m
[32m+[m[32mKod, migration, testler ve diff belgelerle uyumlu mu?[m
[32m+[m
[32m+[m[32mBir gate onaylanmadan sonraki kritik aşamaya geçilmemelidir.[m
[32m+[m
[32m+[m[32m## XV. Evolution Over Rewrite[m
[32m+[m
[32m+[m[32mPlatform sürüm sürüm büyütülecektir.[m
[32m+[m
[32m+[m[32mYeni özelliklerin eklenmesi mevcut sistemi gereksiz yere yeniden yazmayı gerektirmemelidir.[m
[32m+[m
[32m+[m[32mTercih edilen yaklaşım:[m
[32m+[m
[32m+[m[32mKüçük çalışan çekirdek[m
[32m+[m[32m→ Gerçek kullanım[m
[32m+[m[32m→ Yeni gereksinim[m
[32m+[m[32m→ Kontrollü genişleme[m
[32m+[m
[32m+[m[32mÜrünün geleceği tahmin edilerek değil, doğrulanan ihtiyaçlara göre geliştirilmelidir.[m
[32m+[m
